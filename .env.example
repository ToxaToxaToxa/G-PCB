# G-PCB build settings. Copy to .env (never committed) and fill in.
# Without these values the app sends no telemetry at all.

# Crash reports: DSN of your Sentry project (Settings > Client Keys)
VITE_SENTRY_DSN=

# Usage statistics, asked for with an opt-in dialog on first start: PostHog project
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Source map upload to Sentry (optional, build machine only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
